<div class="hero-atmosphere" aria-hidden="true" data-hero-atmosphere>
  <div class="hero-atmosphere__rays" data-side-rays></div>
</div>

<script>
  import { Mesh, Program, Renderer, Triangle } from 'ogl';

  // Adapted from React Bits SideRays at commit d26ed7a476148f1253cca3f5bc9f679fda53e1f5.
  // See THIRD_PARTY_NOTICES.md for the license and contribution boundary.

  const vertexShader = `
    attribute vec2 position;
    void main() {
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const fragmentShader = `
    precision highp float;

    uniform float iTime;
    uniform vec2 iResolution;
    uniform float iSpeed;
    uniform vec3 iRayColor1;
    uniform vec3 iRayColor2;
    uniform float iIntensity;
    uniform float iSpread;
    uniform float iFlipX;
    uniform float iFlipY;
    uniform float iTilt;
    uniform float iSaturation;
    uniform float iBlend;
    uniform float iFalloff;
    uniform float iOpacity;
    uniform float iDarkRays;
    uniform float iSourceX;
    uniform float iSourceY;

    float rayStrength(
      vec2 raySource,
      vec2 rayReferenceDirection,
      vec2 coord,
      float seedA,
      float seedB,
      float speed
    ) {
      vec2 sourceToCoord = coord - raySource;
      float cosine = dot(normalize(sourceToCoord), rayReferenceDirection);
      return clamp(
        (0.45 + 0.15 * sin(cosine * seedA + iTime * speed)) +
        (0.3 + 0.2 * cos(-cosine * seedB + iTime * speed)),
        0.0,
        1.0
      ) * clamp((iResolution.x - length(sourceToCoord)) / iResolution.x, 0.5, 1.0);
    }

    void main() {
      vec2 fragCoord = gl_FragCoord.xy;
      if (iFlipX > 0.5) fragCoord.x = iResolution.x - fragCoord.x;
      if (iFlipY > 0.5) fragCoord.y = iResolution.y - fragCoord.y;

      vec2 coord = vec2(fragCoord.x, iResolution.y - fragCoord.y);
      vec2 rayPosition = vec2(iResolution.x * iSourceX, iSourceY * iResolution.y);
      float tiltRadians = iTilt * 3.14159265 / 180.0;
      float cosineTilt = cos(tiltRadians);
      float sineTilt = sin(tiltRadians);
      vec2 relativeCoord = coord - rayPosition;
      vec2 tiltedCoord = vec2(
        relativeCoord.x * cosineTilt - relativeCoord.y * sineTilt,
        relativeCoord.x * sineTilt + relativeCoord.y * cosineTilt
      ) + rayPosition;

      float halfSpread = iSpread * 0.275;
      vec2 direction1 = normalize(vec2(
        cos(0.785398 + halfSpread),
        sin(0.785398 + halfSpread)
      ));
      vec2 direction2 = normalize(vec2(
        cos(0.785398 - halfSpread),
        sin(0.785398 - halfSpread)
      ));

      float rayStrength1 = rayStrength(
        rayPosition,
        direction1,
        tiltedCoord,
        36.2214,
        21.11349,
        iSpeed
      );
      float rayStrength2 = rayStrength(
        rayPosition,
        direction2,
        tiltedCoord,
        22.3991,
        18.0234,
        iSpeed * 0.2
      );

      vec4 rays1 = vec4(iRayColor1, 1.0) * rayStrength1;
      vec4 rays2 = vec4(iRayColor2, 1.0) * rayStrength2;

      vec4 color = rays1 * (1.0 - iBlend) * 0.9 + rays2 * iBlend * 0.9;
      float distanceToLight = length(
        fragCoord - vec2(rayPosition.x, iResolution.y - rayPosition.y)
      ) / iResolution.y;
      float brightness = iIntensity * 0.4 / pow(max(distanceToLight, 0.001), iFalloff);
      color.rgb *= brightness;

      float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
      color.rgb = clamp(mix(vec3(gray), color.rgb, iSaturation), 0.0, 1.0);
      if (iDarkRays > 0.5) {
        float rayMask = rayStrength1 * (1.0 - iBlend) + rayStrength2 * iBlend;
        color.rgb = vec3(0.025, 0.03, 0.035);
        color.a = clamp(rayMask * brightness * iOpacity * 0.3, 0.0, 0.28);
      } else {
        color.a = clamp(max(color.r, max(color.g, color.b)) * iOpacity, 0.0, 1.0);
      }
      gl_FragColor = color;
    }
  `;

  const hexToVec3 = (hex: string) => {
    const value = hex.replace('#', '');
    return [
      Number.parseInt(value.slice(0, 2), 16) / 255,
      Number.parseInt(value.slice(2, 4), 16) / 255,
      Number.parseInt(value.slice(4, 6), 16) / 255,
    ];
  };

  const root = document.querySelector<HTMLElement>('[data-hero-atmosphere]');

  if (root && root.dataset.initialized !== 'true') {
    root.dataset.initialized = 'true';
    const container = root.querySelector<HTMLElement>('[data-side-rays]');

    if (container) {
      try {
        const renderer = new Renderer({
          alpha: true,
          dpr: Math.min(window.devicePixelRatio || 1, window.innerWidth < 700 ? 1 : 1.5),
          premultipliedAlpha: false,
          powerPreference: 'low-power',
        });
        const gl = renderer.gl;
        gl.clearColor(0, 0, 0, 0);
        gl.canvas.style.width = '100%';
        gl.canvas.style.height = '100%';
        container.appendChild(gl.canvas);

        const program = new Program(gl, {
          vertex: vertexShader,
          fragment: fragmentShader,
          transparent: true,
          uniforms: {
            iTime: { value: 0 },
            iResolution: { value: [1, 1] },
            iSpeed: { value: 2.5 },
            iRayColor1: { value: hexToVec3('#EAB308') },
            iRayColor2: { value: hexToVec3('#96c8ff') },
            iIntensity: { value: 2 },
            iSpread: { value: 2.2 },
            iFlipX: { value: 0 },
            iFlipY: { value: 0 },
            iTilt: { value: 0 },
            iSaturation: { value: 1.5 },
            iBlend: { value: 0.75 },
            iFalloff: { value: 1.6 },
            iOpacity: { value: 1 },
            iDarkRays: { value: 0 },
            iSourceX: { value: 1.12 },
            iSourceY: { value: -0.58 },
          },
        });
        const mesh = new Mesh(gl, { geometry: new Triangle(gl), program });

        const rayThemes = {
          dark: {
            color1: '#EAB308',
            color2: '#96c8ff',
            intensity: 2,
            saturation: 1.5,
            blend: 0.75,
            falloff: 1.6,
            opacity: 1,
          },
          light: {
            color1: '#000000',
            color2: '#000000',
            intensity: 2.2,
            saturation: 0,
            blend: 0.62,
            falloff: 1.25,
            opacity: 1,
          },
        } as const;

        const applyTheme = () => {
          const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          const settings = rayThemes[theme];
          program.uniforms.iRayColor1.value = hexToVec3(settings.color1);
          program.uniforms.iRayColor2.value = hexToVec3(settings.color2);
          program.uniforms.iIntensity.value = settings.intensity;
          program.uniforms.iSaturation.value = settings.saturation;
          program.uniforms.iBlend.value = settings.blend;
          program.uniforms.iFalloff.value = settings.falloff;
          program.uniforms.iOpacity.value = settings.opacity;
          program.uniforms.iDarkRays.value = theme === 'light' ? 1 : 0;
          render(performance.now());
        };

        const resize = () => {
          renderer.setSize(Math.max(container.clientWidth, 1), Math.max(container.clientHeight, 1));
          program.uniforms.iResolution.value = [gl.canvas.width, gl.canvas.height];
          const isDesktop = container.clientWidth >= 900;
          program.uniforms.iSourceX.value = isDesktop ? 1.12 : 1.02;
          program.uniforms.iSourceY.value = isDesktop ? -0.58 : -0.22;
          program.uniforms.iSpread.value = isDesktop ? 2.35 : 2;
        };

        const render = (time: number) => {
          program.uniforms.iTime.value = time * 0.001;
          renderer.render({ scene: mesh });
        };

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let frameId = 0;
        let isVisible = true;

        const stop = () => {
          if (frameId) window.cancelAnimationFrame(frameId);
          frameId = 0;
        };

        const loop = (time: number) => {
          render(time);
          frameId = window.requestAnimationFrame(loop);
        };

        const start = () => {
          if (!frameId && isVisible && !document.hidden && !reducedMotion.matches) {
            frameId = window.requestAnimationFrame(loop);
          }
        };

        const handleMotionPreference = () => {
          stop();
          render(0);
          start();
        };

        const handleVisibility = () => {
          if (document.hidden) stop();
          else start();
        };

        const visibilityObserver = new IntersectionObserver(
          ([entry]) => {
            isVisible = entry?.isIntersecting ?? false;
            if (isVisible) start();
            else stop();
          },
          { threshold: 0.01 },
        );
        const resizeObserver = new ResizeObserver(() => {
          resize();
          render(0);
        });
        const themeObserver = new MutationObserver(applyTheme);

        resize();
        applyTheme();
        render(0);
        visibilityObserver.observe(root);
        resizeObserver.observe(root);
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        document.addEventListener('visibilitychange', handleVisibility);
        reducedMotion.addEventListener('change', handleMotionPreference);
        start();

        window.addEventListener(
          'pagehide',
          () => {
            stop();
            visibilityObserver.disconnect();
            resizeObserver.disconnect();
            themeObserver.disconnect();
            document.removeEventListener('visibilitychange', handleVisibility);
            reducedMotion.removeEventListener('change', handleMotionPreference);
            gl.getExtension('WEBGL_lose_context')?.loseContext();
          },
          { once: true },
        );
      } catch {
        root.dataset.webglUnavailable = 'true';
      }
    }
  }
</script>

<style>
  .hero-atmosphere,
  .hero-atmosphere__rays {
    position: absolute;
    overflow: hidden;
    pointer-events: none;
    inset: 0;
  }

  .hero-atmosphere {
    z-index: 0;
  }

  .hero-atmosphere__rays {
    opacity: 1;
  }
</style>
