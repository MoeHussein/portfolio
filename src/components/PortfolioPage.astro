---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ar' | 'tr';
}

const { locale } = Astro.props;
const entry = await getEntry('profile', locale);
if (!entry) throw new Error(`Missing portfolio content for locale: ${locale}`);
const content = entry.data;
const { ui } = content;
const base = import.meta.env.BASE_URL;
const localeUrl = (value: 'en' | 'ar' | 'tr') => (value === 'en' ? base : `${base}${value}/`);
const cvPath = `${base}downloads/mohammad-hussein-cv-${locale}.pdf`;

const labels = {
  en: {
    work: 'Selected work',
    profile: 'Profile',
    intro: 'Researcher · Engineer · Builder',
    workTitle: 'Seven projects. Three different ways of thinking.',
    workCopy:
      'Optical systems, patient-specific models and digital products. Open a card for the full story.',
    paper: 'Published in Biomedical Optics Express',
    readPaper: 'Read paper',
    explore: 'Open case study',
    experience: 'Experience & education',
    skills: 'Capabilities',
    recognition: 'Recognition & learning',
    profileTitle: 'The useful details, without the wall of text.',
    current: 'Now',
    learningNote: 'Independent study through public materials · not completed certifications',
    openTo: 'Open to',
  },
  ar: {
    work: 'أعمال مختارة',
    profile: 'الملف',
    intro: 'باحث · مهندس · صانع',
    workTitle: 'سبعة مشاريع وثلاث طرق مختلفة للتفكير.',
    workCopy: 'أنظمة بصرية ونماذج خاصة بالمرضى ومنتجات رقمية. افتح أي بطاقة للتفاصيل.',
    paper: 'منشور في Biomedical Optics Express',
    readPaper: 'اقرأ البحث',
    explore: 'افتح دراسة الحالة',
    experience: 'الخبرة والتعليم',
    skills: 'القدرات',
    recognition: 'التقدير والتعلم',
    profileTitle: 'التفاصيل المهمة من دون جدار من النصوص.',
    current: 'الآن',
    learningNote: 'تعلم مستقل من مواد عامة · ليست شهادات مكتملة',
    openTo: 'متاح لـ',
  },
  tr: {
    work: 'Seçili çalışmalar',
    profile: 'Profil',
    intro: 'Araştırmacı · Mühendis · Üretici',
    workTitle: 'Yedi proje. Üç farklı düşünme biçimi.',
    workCopy:
      'Optik sistemler, hastaya özgü modeller ve dijital ürünler. Ayrıntılar için kartı açın.',
    paper: 'Biomedical Optics Express’te yayımlandı',
    readPaper: 'Makaleyi oku',
    explore: 'Vaka çalışmasını aç',
    experience: 'Deneyim ve eğitim',
    skills: 'Yetkinlikler',
    recognition: 'Başarılar ve öğrenme',
    profileTitle: 'Metin duvarı olmadan gerekli ayrıntılar.',
    current: 'Şimdi',
    learningNote: 'Açık materyallerle bağımsız çalışma · tamamlanmış sertifikalar değildir',
    openTo: 'Açık olduğum alanlar',
  },
}[locale];

const projectTone = ['cyan', 'violet', 'coral', 'cyan', 'violet', 'coral', 'cyan'];
---

<BaseLayout
  locale={content.locale}
  direction={content.direction}
  title={content.metadata.title}
  description={content.metadata.description}
  name={content.name}
  headline={content.headline}
>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label={content.name}>M. Hussein</a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#work">{labels.work}</a>
      <a href="#profile">{labels.profile}</a>
      <a href="#contact">{ui.contact}</a>
    </nav>

    <div class="header-actions">
      <details class="language-switcher">
        <summary aria-label={ui.language}>{locale.toUpperCase()}</summary>
        <div class="language-menu">
          <a href={localeUrl('en')} lang="en" data-locale-link="en">English</a>
          <a href={localeUrl('ar')} lang="ar" dir="rtl" data-locale-link="ar">العربية</a>
          <a href={localeUrl('tr')} lang="tr" data-locale-link="tr">Türkçe</a>
        </div>
      </details>
      <button class="theme-toggle" type="button" aria-label={ui.theme} data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42M18.36 5.64l-1.42 1.42M7.06 16.94l-1.42 1.42"
          ></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
      </button>
      <a class="header-contact" href={`mailto:${content.contact.email}`}>{ui.contact}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>{labels.intro}</p>
        <h1>{content.name}</h1>
        <p class="headline">{content.headline}</p>
        <p class="hero-statement">{content.hero.statement}</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#work"
            >{labels.work}<span aria-hidden="true">↓</span></a
          >
          <a class="button button--secondary" href={cvPath} download>{ui.downloadCv}</a>
        </div>
      </div>

      <aside class="hero-console" aria-label={content.hero.availability}>
        <div class="console-top"><span>MMH / 2026</span><i></i><i></i><i></i></div>
        <div class="console-field" aria-hidden="true">
          <span class="beam beam--one"></span>
          <span class="beam beam--two"></span>
          <span class="scanline"></span>
          <strong>LIGHT<br />→ DATA</strong>
          <small>λ · φ · FFT · J</small>
        </div>
        <div class="console-bottom">
          <span class="status-dot"></span>
          <p>{content.hero.availability}</p>
        </div>
      </aside>
    </section>

    <section class="work-section" id="work">
      <div class="section-intro">
        <div>
          <p class="section-label">01 / {labels.work}</p>
          <h2>{labels.workTitle}</h2>
        </div>
        <p>{labels.workCopy}</p>
      </div>

      <a class="paper-strip" href={content.research.doi} target="_blank" rel="noreferrer">
        <span class="paper-signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <span><small>{labels.paper}</small><strong>{content.research.paperTitle}</strong></span>
        <b>{labels.readPaper} ↗</b>
      </a>

      <div class="project-grid">
        {
          content.projects.map((project, index) => (
            <article
              class:list={[
                'project-card',
                `project-card--${projectTone[index]}`,
                index < 2 && 'project-card--large',
              ]}
            >
              <div class="card-visual" aria-hidden="true">
                <span class="visual-index">0{index + 1}</span>
                <span class:list={['visual-mark', `visual-mark--${index + 1}`]} />
                <span class="visual-sweep" />
              </div>
              <div class="card-content">
                <p class="project-status">{project.status}</p>
                <h3>{project.title}</h3>
                <p class="project-summary">{project.summary}</p>
                <ul class="technology-list" aria-label={ui.technologies}>
                  {project.technologies.slice(0, 3).map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
              </div>
              <button
                class="card-action"
                type="button"
                data-dialog-open={`project-${project.id}`}
                aria-label={`${labels.explore}: ${project.title}`}
              >
                <>
                  <span>{labels.explore}</span>
                  <b aria-hidden="true">↗</b>
                </>
              </button>
            </article>
          ))
        }
      </div>
    </section>

    <section class="profile-section" id="profile">
      <div class="section-intro section-intro--profile">
        <div>
          <p class="section-label">02 / {labels.profile}</p>
          <h2>{labels.profileTitle}</h2>
        </div>
      </div>

      <div class="profile-shell">
        <div class="profile-tabs" role="tablist" aria-label={labels.profile}>
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-experience"
            id="tab-experience"
            data-profile-tab="experience">{labels.experience}</button
          >
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-skills"
            id="tab-skills"
            data-profile-tab="skills">{labels.skills}</button
          >
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-recognition"
            id="tab-recognition"
            data-profile-tab="recognition">{labels.recognition}</button
          >
        </div>

        <div
          class="profile-panel"
          id="panel-experience"
          role="tabpanel"
          aria-labelledby="tab-experience"
          data-profile-panel="experience"
        >
          <div class="profile-column">
            {
              content.timeline.map((item) => (
                <article class="profile-item">
                  <time>{item.period}</time>
                  <h3>{item.title}</h3>
                  <p>{item.organization}</p>
                </article>
              ))
            }
          </div>
          <div class="profile-column">
            {
              content.education.map((item) => (
                <article class="profile-item profile-item--education">
                  <time>{item.period}</time>
                  <h3>{item.degree}</h3>
                  <p>{item.institution}</p>
                  <ul>
                    {item.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div
          class="profile-panel skills-panel"
          id="panel-skills"
          role="tabpanel"
          aria-labelledby="tab-skills"
          data-profile-panel="skills"
          hidden
        >
          {
            content.skillGroups.map((group, index) => (
              <article class="skill-card">
                <span>0{index + 1}</span>
                <h3>{group.title}</h3>
                <p>{group.items.join(' · ')}</p>
              </article>
            ))
          }
        </div>

        <div
          class="profile-panel recognition-panel"
          id="panel-recognition"
          role="tabpanel"
          aria-labelledby="tab-recognition"
          data-profile-panel="recognition"
          hidden
        >
          <div class="recognition-list">
            {
              content.achievements.map((item) => (
                <article>
                  <>
                    <time>{item.date}</time>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </>
                </article>
              ))
            }
          </div>
          <div class="learning-card">
            <p class="section-label">{ui.learning}</p>
            <small>{labels.learningNote}</small>
            <ul>
              {
                content.learning.map((item) => (
                  <li>
                    <a href={item.url} target="_blank" rel="noreferrer">
                      {item.label}
                      <span>↗</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="open-to-strip">
        <span>{labels.openTo}</span>
        {content.collaboration.map((item) => <strong>{item.title}</strong>)}
      </div>
    </section>

    <section class="contact-section" id="contact">
      <div>
        <p class="section-label">03 / {ui.contact}</p>
        <h2>{ui.contactTitle}</h2>
        <p>{ui.contactText}</p>
      </div>
      <div class="contact-actions">
        <a class="contact-email" href={`mailto:${content.contact.email}`}
          >{content.contact.email}<span aria-hidden="true">↗</span></a
        >
        <div class="contact-links">
          <a href={content.contact.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={content.contact.orcid} target="_blank" rel="noreferrer">ORCID ↗</a>
          <span>{content.contact.location}</span>
        </div>
      </div>
    </section>
  </main>

  <footer><span>© 2026 {content.name}</span><span>{ui.copyright}</span><a href="#top">↑</a></footer>

  {
    content.projects.map((project) => (
      <dialog
        class="case-study-dialog"
        id={`project-${project.id}`}
        aria-labelledby={`title-${project.id}`}
      >
        <div class="dialog-shell">
          <div class="dialog-header">
            <div>
              <>
                <p class="project-status">{project.status}</p>
                <h2 id={`title-${project.id}`}>{project.title}</h2>
              </>
            </div>
            <button type="button" class="dialog-close" data-dialog-close aria-label={ui.close}>
              ×
            </button>
          </div>
          <div class="dialog-grid">
            <section>
              <>
                <h3>{ui.problem}</h3>
                <p>{project.problem}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.role}</h3>
                <p>{project.role}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.process}</h3>
                <p>{project.process}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.outcome}</h3>
                <p>{project.outcome}</p>
              </>
            </section>
          </div>
          <div class="dialog-footer">
            <ul class="technology-list" aria-label={ui.technologies}>
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {project.links.length > 0 && (
              <div class="dialog-links">
                {project.links.map((link) => (
                  <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </dialog>
    ))
  }

  <script>
    const root = document.documentElement;
    document
      .querySelector<HTMLButtonElement>('[data-theme-toggle]')
      ?.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = nextTheme;
        localStorage.setItem('portfolio-theme', nextTheme);
      });

    document
      .querySelectorAll<HTMLElement>('[data-locale-link]')
      .forEach((link) =>
        link.addEventListener('click', () =>
          localStorage.setItem('portfolio-locale', link.dataset.localeLink ?? 'en'),
        ),
      );

    document
      .querySelectorAll<HTMLButtonElement>('[data-dialog-open]')
      .forEach((button) =>
        button.addEventListener('click', () =>
          (
            document.getElementById(button.dataset.dialogOpen ?? '') as HTMLDialogElement | null
          )?.showModal(),
        ),
      );
    document.querySelectorAll<HTMLDialogElement>('.case-study-dialog').forEach((dialog) => {
      dialog
        .querySelector<HTMLButtonElement>('[data-dialog-close]')
        ?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-profile-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-profile-panel]')];
    const selectTab = (tab: HTMLButtonElement) => {
      const selected = tab.dataset.profileTab;
      tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.profilePanel !== selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        if (!next) return;
        next.focus();
        selectTab(next);
      });
    });

    const header = document.querySelector<HTMLElement>('[data-header]');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  </script>
</BaseLayout>
