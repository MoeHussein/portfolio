---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OpticField from './OpticField.astro';

interface Props {
  locale: 'en' | 'ar' | 'tr';
}

const { locale } = Astro.props;
const entry = await getEntry('profile', locale);
if (!entry) throw new Error(`Missing portfolio content for locale: ${locale}`);
const content = entry.data;
const { ui } = content;
const base = import.meta.env.BASE_URL;
const localeUrl = (value: 'en' | 'ar' | 'tr') => (value === 'en' ? base : `${base}${value}/`);
const cvPath = `${base}downloads/mohammad-hussein-cv-${locale}.pdf`;
const featuredProjects = content.projects.filter((project) => project.featured);
const productProjects = content.projects.filter((project) => !project.featured);
const aboutLabel = content.nav.find((item) => item.href === '#about')?.label ?? content.about.title;
const projectsLabel = content.nav.find((item) => item.href === '#projects')?.label ?? 'Projects';
---

<BaseLayout
  locale={content.locale}
  direction={content.direction}
  title={content.metadata.title}
  description={content.metadata.description}
  name={content.name}
  headline={content.headline}
>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label={content.name}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
      <span class="brand-name">M. Hussein</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {content.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <details class="language-switcher">
        <summary aria-label={ui.language}>{locale.toUpperCase()}</summary>
        <div class="language-menu">
          <a href={localeUrl('en')} lang="en" data-locale-link="en">English</a>
          <a href={localeUrl('ar')} lang="ar" dir="rtl" data-locale-link="ar">العربية</a>
          <a href={localeUrl('tr')} lang="tr" data-locale-link="tr">Türkçe</a>
        </div>
      </details>
      <button class="theme-toggle" type="button" aria-label={ui.theme} data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42M18.36 5.64l-1.42 1.42M7.06 16.94l-1.42 1.42"
          ></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
      </button>
      <a class="header-contact" href={`mailto:${content.contact.email}`}>{ui.contact}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-copy">
        <h1>{content.name}</h1>
        <p class="headline">{content.headline}</p>
        <p class="hero-statement">{content.hero.statement}</p>
        <div class="hero-actions">
          <a class="button button--primary" href={`mailto:${content.contact.email}`}>{ui.contact}</a
          >
          <a class="button button--secondary" href={cvPath} download>{ui.downloadCv}</a>
        </div>
        <p class="availability"><span></span>{content.hero.availability}</p>
      </div>
      <div class="hero-visual">
        <OpticField />
      </div>
      <a class="scroll-cue" href="#about" aria-label={aboutLabel}>
        <span></span>
      </a>
    </section>

    <section class="section about-section" id="about">
      <div class="section-index" aria-hidden="true">01</div>
      <div class="section-heading">
        <p class="section-label">{aboutLabel}</p>
        <h2>{content.about.title}</h2>
      </div>
      <div class="about-copy">
        {
          content.about.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 && 'lead-paragraph']}>{paragraph}</p>
          ))
        }
      </div>
    </section>

    <section class="section research-section" id="research">
      <div class="section-index" aria-hidden="true">02</div>
      <div class="research-layout">
        <div class="research-meta">
          <p class="section-label">{content.research.title}</p>
          <span class="research-year">2026</span>
          <span>Biomedical Optics Express</span>
        </div>
        <article class="research-feature">
          <h2>{content.research.paperTitle}</h2>
          <p class="citation">{content.research.citation}</p>
          <p>{content.research.explanation}</p>
          <div class="research-note">
            <span aria-hidden="true">i</span>
            <p>{content.research.limitation}</p>
          </div>
          <a class="text-link" href={content.research.doi} target="_blank" rel="noreferrer">
            {ui.viewResearch}<span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </section>

    <section class="section projects-section" id="projects">
      <div class="section-index" aria-hidden="true">03</div>
      <div class="section-heading section-heading--wide">
        <p class="section-label">{projectsLabel}</p>
        <h2>
          {
            locale === 'ar'
              ? 'بحث ومنتجات مبنية لحل مشكلات حقيقية'
              : locale === 'tr'
                ? 'Gerçek problemler için araştırma ve ürünler'
                : 'Research and products built around real problems'
          }
        </h2>
      </div>

      <div class="featured-projects">
        {
          featuredProjects.map((project, index) => (
            <article class="project-feature" style={`--project-index:${index}`}>
              <div class="project-number">0{index + 1}</div>
              <div class="project-main">
                <p class="project-status">{project.status}</p>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul class="technology-list" aria-label={ui.technologies}>
                  {project.technologies.slice(0, 4).map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
              </div>
              <button
                class="case-study-button"
                type="button"
                data-dialog-open={`project-${project.id}`}
              >
                <>
                  <span>{ui.viewCaseStudy}</span>
                  <span aria-hidden="true">↗</span>
                </>
              </button>
            </article>
          ))
        }
      </div>

      <div class="project-rail">
        {
          productProjects.map((project) => (
            <article class="project-card">
              <div>
                <p class="project-status">{project.status}</p>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
              <button
                class="icon-button"
                type="button"
                data-dialog-open={`project-${project.id}`}
                aria-label={`${ui.viewCaseStudy}: ${project.title}`}
              >
                ↗
              </button>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <div class="section-index" aria-hidden="true">04</div>
      <div class="section-heading section-heading--wide">
        <p class="section-label">{ui.experience}</p>
        <h2>
          {
            locale === 'ar'
              ? 'مسار علمي متعدد التخصصات'
              : locale === 'tr'
                ? 'Disiplinler arası bilimsel bir yol'
                : 'A multidisciplinary scientific path'
          }
        </h2>
      </div>
      <div class="experience-grid">
        <div class="timeline">
          {
            content.timeline.map((item) => (
              <article class="timeline-item">
                <p class="timeline-period">{item.period}</p>
                <div>
                  <h3>{item.title}</h3>
                  <p class="timeline-org">{item.organization}</p>
                  <p>{item.description}</p>
                </div>
              </article>
            ))
          }
        </div>
        <div class="education-list">
          {
            content.education.map((item) => (
              <article class="education-item">
                <p>{item.period}</p>
                <h3>{item.degree}</h3>
                <p class="timeline-org">{item.institution}</p>
                <ul>
                  {item.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section skills-section" id="skills">
      <div class="section-index" aria-hidden="true">05</div>
      <div class="section-heading">
        <p class="section-label">{ui.skills}</p>
        <h2>
          {
            locale === 'ar'
              ? 'من القياس البصري إلى النماذج الرقمية'
              : locale === 'tr'
                ? 'Optik ölçümden dijital modellere'
                : 'From optical measurement to digital models'
          }
        </h2>
      </div>
      <div class="skills-grid">
        {
          content.skillGroups.map((group, index) => (
            <article class="skill-group">
              <span>0{index + 1}</span>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section achievements-section">
      <div class="section-heading section-heading--wide">
        <p class="section-label">{ui.achievements}</p>
      </div>
      <div class="achievement-list">
        {
          content.achievements.map((item) => (
            <article class="achievement-item">
              <time>{item.date}</time>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section learning-section">
      <div>
        <p class="section-label">{ui.learning}</p>
        <p class="learning-intro">
          {
            locale === 'ar'
              ? 'تعلم مستقل من المواد العامة. ليست شهادات مكتملة.'
              : locale === 'tr'
                ? 'Açık materyallerden bağımsız öğrenme. Tamamlanmış sertifikalar değildir.'
                : 'Independent study through public materials. These are not completed certifications.'
          }
        </p>
      </div>
      <ol class="learning-list">
        {
          content.learning.map((item, index) => (
            <li>
              <span>0{index + 1}</span>
              <a href={item.url} target="_blank" rel="noreferrer">
                {item.label}
                <i aria-hidden="true">↗</i>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section collaboration-section">
      <div class="section-heading section-heading--wide">
        <p class="section-label">{ui.collaboration}</p>
      </div>
      <div class="collaboration-grid">
        {
          content.collaboration.map((item, index) => (
            <article>
              <span aria-hidden="true">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="contact-section" id="contact">
      <div class="contact-light" aria-hidden="true"></div>
      <p class="section-label">{ui.contact}</p>
      <h2>{ui.contactTitle}</h2>
      <p>{ui.contactText}</p>
      <a class="contact-email" href={`mailto:${content.contact.email}`}
        >{content.contact.email}<span aria-hidden="true">↗</span></a
      >
      <div class="contact-links">
        <a href={content.contact.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href={content.contact.orcid} target="_blank" rel="noreferrer">ORCID ↗</a>
        <span>{content.contact.location}</span>
      </div>
    </section>
  </main>

  <footer>
    <span>© 2026 {content.name}</span>
    <span>{ui.copyright}</span>
    <a href="#top">↑</a>
  </footer>

  {
    content.projects.map((project) => (
      <dialog
        class="case-study-dialog"
        id={`project-${project.id}`}
        aria-labelledby={`title-${project.id}`}
      >
        <div class="dialog-shell">
          <div class="dialog-header">
            <div>
              <p class="project-status">{project.status}</p>
              <h2 id={`title-${project.id}`}>{project.title}</h2>
            </div>
            <button type="button" class="dialog-close" data-dialog-close aria-label={ui.close}>
              ×
            </button>
          </div>
          <div class="dialog-grid">
            <section>
              <>
                <h3>{ui.problem}</h3>
                <p>{project.problem}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.role}</h3>
                <p>{project.role}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.process}</h3>
                <p>{project.process}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.outcome}</h3>
                <p>{project.outcome}</p>
              </>
            </section>
          </div>
          <div class="dialog-footer">
            <ul class="technology-list" aria-label={ui.technologies}>
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {project.links.length > 0 && (
              <div class="dialog-links">
                {project.links.map((link) => (
                  <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </dialog>
    ))
  }

  <script>
    const root = document.documentElement;
    const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

    themeToggle?.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = nextTheme;
      localStorage.setItem('portfolio-theme', nextTheme);
    });

    document.querySelectorAll<HTMLElement>('[data-locale-link]').forEach((link) => {
      link.addEventListener('click', () => {
        localStorage.setItem('portfolio-locale', link.dataset.localeLink ?? 'en');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(
          button.dataset.dialogOpen ?? '',
        ) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.case-study-dialog').forEach((dialog) => {
      dialog
        .querySelector<HTMLButtonElement>('[data-dialog-close]')
        ?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

    const header = document.querySelector<HTMLElement>('[data-header]');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  </script>
</BaseLayout>
