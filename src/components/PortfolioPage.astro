---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAtmosphere from './HeroAtmosphere.astro';

interface Props {
  locale: 'en' | 'tr';
}

const { locale } = Astro.props;
const entry = await getEntry('profile', locale);
if (!entry) throw new Error(`Missing portfolio content for locale: ${locale}`);
const content = entry.data;
const { ui } = content;
const base = import.meta.env.BASE_URL;
const localeUrl = (value: 'en' | 'tr') => (value === 'en' ? base : `${base}${value}/`);
const cvPath = `${base}downloads/mohammad-hussein-cv-${locale}.pdf`;
const heroLine = `${content.hero.statement.split('. ')[0]}.`;

const labels = {
  en: {
    work: 'Selected Work',
    profile: 'Profile',
    view: 'View',
    story: 'About',
    experience: 'Experience & Education',
    capabilities: 'Capabilities',
    recognition: 'Recognition',
    learning: 'Currently learning',
    light: 'Light',
    dark: 'Dark',
    independent: 'Independent study through public materials, not completed certifications.',
    academic: 'Academic Work',
    personal: 'Personal & Product Work',
  },
  tr: {
    work: 'Seçili Çalışmalar',
    profile: 'Profil',
    view: 'Görüntüle',
    story: 'Hakkımda',
    experience: 'Deneyim ve Eğitim',
    capabilities: 'Yetkinlikler',
    recognition: 'Başarılar',
    learning: 'Şu anda öğreniyorum',
    light: 'Açık',
    dark: 'Koyu',
    independent: 'Açık materyallerle bağımsız çalışma, tamamlanmış sertifikalar değildir.',
    academic: 'Akademik Çalışmalar',
    personal: 'Kişisel ve Ürün Çalışmaları',
  },
}[locale];

const academicProjectIds = new Set([
  'dual-shot-pdhm',
  'reference-free-phase-bias',
  'patient-specific-knee',
]);
const projectGroups = [
  {
    id: 'academic',
    title: labels.academic,
    projects: content.projects.filter((project) => academicProjectIds.has(project.id)),
  },
  {
    id: 'personal',
    title: labels.personal,
    projects: content.projects.filter((project) => !academicProjectIds.has(project.id)),
  },
];
---

<BaseLayout
  locale={content.locale}
  direction={content.direction}
  title={content.metadata.title}
  description={content.metadata.description}
  name={content.name}
  headline={content.headline}
>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label={content.name}>{content.name}</a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#work">{labels.work}</a>
      <a href="#profile">{labels.profile}</a>
      <a href="#contact">{ui.contact}</a>
    </nav>
    <div class="header-actions">
      <details class="language-switcher">
        <summary aria-label={ui.language}>{locale.toUpperCase()}</summary>
        <div class="language-menu">
          <a href={localeUrl('en')} lang="en" data-locale-link="en">English</a>
          <a href={localeUrl('tr')} lang="tr" data-locale-link="tr">Türkçe</a>
        </div>
      </details>
      <button class="theme-toggle" type="button" aria-label={ui.theme} data-theme-toggle>
        <svg
          class="theme-icon theme-icon--sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="3.5"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon--moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.25 15.35A8.5 8.5 0 0 1 8.65 3.75 8.5 8.5 0 1 0 20.25 15.35Z"></path>
        </svg>
      </button>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <HeroAtmosphere />
      <div class="hero-content">
        <h1>{content.name}</h1>
        <p class="headline">{content.headline}</p>
        <p class="hero-statement">{heroLine}</p>
        <blockquote class="hero-verse">
          <p class="hero-verse-arabic" lang="ar" dir="rtl">
            ﴿<strong>وَتَوَكَّلْ</strong> عَلَى اللَّهِ وَكَفَىٰ <strong>بِاللَّهِ</strong> وَكِيلًا﴾
          </p>
          <p class="hero-verse-translation" lang="en">
            And rely upon Allah; and sufficient is Allah as Disposer of affairs.
          </p>
          <footer>Surah Al-Ahzab · 33:3</footer>
        </blockquote>
        <div class="hero-actions">
          <a href={`mailto:${content.contact.email}`}>{ui.contact}</a>
          <a href={cvPath} download>{ui.downloadCv}</a>
        </div>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="work-content">
        <h2>{labels.work}</h2>
        <div class="project-groups">
          {
            projectGroups.map((group) => (
              <section class:list={['project-group', `project-group--${group.id}`]}>
                <div class="project-group-heading">
                  <h3>{group.title}</h3>
                  <span aria-hidden="true" />
                </div>
                <div class="project-cards">
                  {group.projects.map((project) => (
                    <button
                      type="button"
                      class:list={[
                        'project-card',
                        { 'project-card--publication': project.id === 'dual-shot-pdhm' },
                      ]}
                      data-dialog-open={`project-${project.id}`}
                      aria-label={`${labels.view}: ${project.title}`}
                    >
                      <span class="project-card-meta">
                        <span class="project-number">
                          {String(content.projects.indexOf(project) + 1).padStart(2, '0')}
                        </span>
                        <span class="project-status">{project.status}</span>
                      </span>
                      <span class="project-title">
                        <strong>
                          {project.id === 'dual-shot-pdhm'
                            ? content.research.paperTitle
                            : project.title}
                        </strong>
                        <small>{project.summary}</small>
                      </span>
                      <span class="project-card-footer">
                        <span>{project.technologies.slice(0, 2).join(' · ')}</span>
                        <span class="project-view">{labels.view}</span>
                      </span>
                    </button>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <section class="profile-section" id="profile">
      <header class="profile-heading">
        <p>{labels.profile}</p>
      </header>

      <div class="story">
        <p>{content.about.paragraphs[0]}</p>
      </div>

      <div class="profile-groups">
        <section class="profile-group">
          <h3>{labels.experience}</h3>
          <div>
            {
              content.timeline.map((item) => (
                <article class="profile-row">
                  <time>{item.period}</time>
                  <span>
                    <>
                      <strong>{item.title}</strong>
                      <small>{item.organization}</small>
                      <small>{item.description}</small>
                    </>
                  </span>
                </article>
              ))
            }
            {
              content.education.slice(1).map((item) => (
                <article class="profile-row">
                  <time>{item.period}</time>
                  <span>
                    <>
                      <strong>{item.degree}</strong>
                      <small>
                        {item.institution} · {item.details.join(' · ')}
                      </small>
                    </>
                  </span>
                </article>
              ))
            }
          </div>
        </section>

        <section class="profile-group">
          <h3>{labels.capabilities}</h3>
          <div class="capability-list">
            {
              content.skillGroups.map((group) => (
                <article>
                  <>
                    <strong>{group.title}</strong>
                    <p>{group.items.join(' · ')}</p>
                  </>
                </article>
              ))
            }
          </div>
        </section>

        <section class="profile-group">
          <h3>{labels.recognition}</h3>
          <div>
            {
              content.achievements.map((item) => (
                <article class="profile-row">
                  <>
                    <time>{item.date}</time>
                    <span>
                      <>
                        <strong>{item.title}</strong>
                        <small>{item.detail}</small>
                      </>
                    </span>
                  </>
                </article>
              ))
            }
          </div>
        </section>

        <section class="profile-group learning-group">
          <div><h3>{labels.learning}</h3><p>{labels.independent}</p></div>
          <ul>
            {
              content.learning.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noreferrer">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </section>

    <section class="contact-section" id="contact">
      <div class="contact-layout">
        <span
          class="contact-calligraphy"
          role="img"
          aria-label="Alhamdulillah"
          style={`--mark-url: url("${base}alhamdulillah.svg")`}></span>
        <div class="contact-copy">
          <h2>{ui.contact}</h2>
          <a class="contact-email" href={`mailto:${content.contact.email}`}>
            {content.contact.email}
          </a>
          <div class="contact-links">
            <a href={content.contact.github} target="_blank" rel="noreferrer">GitHub</a>
            <a href={content.contact.orcid} target="_blank" rel="noreferrer">ORCID</a>
            <span>{content.contact.location}</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <span>© 2026 {content.name}</span><a href="#top">Top</a>
  </footer>

  {
    content.projects.map((project) => (
      <dialog
        class="case-study-dialog"
        id={`project-${project.id}`}
        aria-labelledby={`title-${project.id}`}
      >
        <div class="dialog-shell">
          <div class="dialog-header">
            <div>
              <>
                <p>{project.status}</p>
                <h2 id={`title-${project.id}`}>{project.title}</h2>
              </>
            </div>
            <button type="button" class="dialog-close" data-dialog-close aria-label={ui.close}>
              Close
            </button>
          </div>
          <div class="dialog-grid">
            <section>
              <>
                <h3>{ui.problem}</h3>
                <p>{project.problem}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.role}</h3>
                <p>{project.role}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.process}</h3>
                <p>{project.process}</p>
              </>
            </section>
            <section>
              <>
                <h3>{ui.outcome}</h3>
                <p>{project.outcome}</p>
              </>
            </section>
          </div>
          <div class="dialog-footer">
            <ul>
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {project.links.length > 0 && (
              <div>
                {project.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </dialog>
    ))
  }

  <script is:inline>
    const root = document.documentElement;
    const header = document.querySelector('[data-header]');
    const themeToggle = document.querySelector('[data-theme-toggle]');

    themeToggle?.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = nextTheme;
      localStorage.setItem('portfolio-theme', nextTheme);
      document
        .querySelector('[data-theme-color]')
        ?.setAttribute('content', nextTheme === 'light' ? '#f5f5f2' : '#0b0f12');
    });

    document
      .querySelectorAll('[data-locale-link]')
      .forEach((link) =>
        link.addEventListener('click', () =>
          localStorage.setItem('portfolio-locale', link.dataset.localeLink ?? 'en'),
        ),
      );
    document
      .querySelectorAll('[data-dialog-open]')
      .forEach((button) =>
        button.addEventListener('click', () =>
          document.getElementById(button.dataset.dialogOpen ?? '')?.showModal(),
        ),
      );
    document.querySelectorAll('.case-study-dialog').forEach((dialog) => {
      dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

    let scheduled = false;
    const updateScroll = () => {
      scheduled = false;
      const y = window.scrollY;
      header?.classList.toggle('is-scrolled', y > 40);
    };
    const requestScrollUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateScroll);
    };
    updateScroll();
    window.addEventListener('scroll', requestScrollUpdate, { passive: true });
    window.addEventListener('resize', requestScrollUpdate, { passive: true });
  </script>
</BaseLayout>
