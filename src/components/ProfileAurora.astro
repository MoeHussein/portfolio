<div class="profile-aurora" aria-hidden="true" data-profile-aurora>
  <div class="profile-aurora__canvas" data-soft-aurora></div>
</div>

<script>
  import { Mesh, Program, Renderer, Triangle } from 'ogl';

  // Adapted from React Bits SoftAurora at commit d26ed7a476148f1253cca3f5bc9f679fda53e1f5.
  // See THIRD_PARTY_NOTICES.md for the license and contribution boundary.

  const vertexShader = `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const fragmentShader = `
    precision highp float;

    uniform float uTime;
    uniform vec3 uResolution;
    uniform float uSpeed;
    uniform float uScale;
    uniform float uBrightness;
    uniform vec3 uColor1;
    uniform vec3 uColor2;
    uniform float uNoiseFrequency;
    uniform float uNoiseAmplitude;
    uniform float uBandHeight;
    uniform float uBandSpread;
    uniform float uOctaveDecay;
    uniform float uLayerOffset;
    uniform float uColorSpeed;
    varying vec2 vUv;

    #define TAU 6.28318

    vec3 gradientHash(vec3 p) {
      p = vec3(
        dot(p, vec3(127.1, 311.7, 234.6)),
        dot(p, vec3(269.5, 183.3, 198.3)),
        dot(p, vec3(169.5, 283.3, 156.9))
      );
      vec3 hash = fract(sin(p) * 43758.5453123);
      float phi = acos(2.0 * hash.x - 1.0);
      float theta = TAU * hash.y;
      return vec3(cos(theta) * sin(phi), sin(theta) * cos(phi), cos(phi));
    }

    float quinticSmooth(float t) {
      float t2 = t * t;
      float t3 = t * t2;
      return 6.0 * t3 * t2 - 15.0 * t2 * t2 + 10.0 * t3;
    }

    vec3 cosineGradient(float t, vec3 a, vec3 b, vec3 c, vec3 d) {
      return a + b * cos(TAU * (c * t + d));
    }

    float perlin3D(float amplitude, float frequency, float px, float py, float pz) {
      float x = px * frequency;
      float y = py * frequency;
      float floorX = floor(x);
      float floorY = floor(y);
      float floorZ = floor(pz);
      float ceilX = ceil(x);
      float ceilY = ceil(y);
      float ceilZ = ceil(pz);

      vec3 g000 = gradientHash(vec3(floorX, floorY, floorZ));
      vec3 g100 = gradientHash(vec3(ceilX, floorY, floorZ));
      vec3 g010 = gradientHash(vec3(floorX, ceilY, floorZ));
      vec3 g110 = gradientHash(vec3(ceilX, ceilY, floorZ));
      vec3 g001 = gradientHash(vec3(floorX, floorY, ceilZ));
      vec3 g101 = gradientHash(vec3(ceilX, floorY, ceilZ));
      vec3 g011 = gradientHash(vec3(floorX, ceilY, ceilZ));
      vec3 g111 = gradientHash(vec3(ceilX, ceilY, ceilZ));

      float d000 = dot(g000, vec3(x - floorX, y - floorY, pz - floorZ));
      float d100 = dot(g100, vec3(x - ceilX, y - floorY, pz - floorZ));
      float d010 = dot(g010, vec3(x - floorX, y - ceilY, pz - floorZ));
      float d110 = dot(g110, vec3(x - ceilX, y - ceilY, pz - floorZ));
      float d001 = dot(g001, vec3(x - floorX, y - floorY, pz - ceilZ));
      float d101 = dot(g101, vec3(x - ceilX, y - floorY, pz - ceilZ));
      float d011 = dot(g011, vec3(x - floorX, y - ceilY, pz - ceilZ));
      float d111 = dot(g111, vec3(x - ceilX, y - ceilY, pz - ceilZ));

      float smoothX = quinticSmooth(x - floorX);
      float smoothY = quinticSmooth(y - floorY);
      float smoothZ = quinticSmooth(pz - floorZ);
      float x00 = mix(d000, d100, smoothX);
      float x10 = mix(d010, d110, smoothX);
      float x01 = mix(d001, d101, smoothX);
      float x11 = mix(d011, d111, smoothX);
      float y0 = mix(x00, x10, smoothY);
      float y1 = mix(x01, x11, smoothY);
      return amplitude * mix(y0, y1, smoothZ);
    }

    float auroraGlow(float time) {
      vec2 uv = gl_FragCoord.xy / uResolution.y;
      float noiseValue = 0.0;
      float frequency = uNoiseFrequency;
      float amplitude = uNoiseAmplitude;
      vec2 samplePosition = uv * uScale;

      for (float octave = 0.0; octave < 3.0; octave += 1.0) {
        noiseValue += perlin3D(
          amplitude,
          frequency,
          samplePosition.x,
          samplePosition.y,
          time
        );
        amplitude *= uOctaveDecay;
        frequency *= 2.0;
      }

      float verticalBand = uv.y * 10.0 - uBandHeight * 10.0;
      return 0.3 * max(
        exp(uBandSpread * (1.0 - 1.1 * abs(noiseValue + verticalBand))),
        0.0
      );
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / uResolution.xy;
      float time = uSpeed * 0.4 * uTime;
      vec3 color = vec3(0.0);
      color += 0.99 * auroraGlow(time) * cosineGradient(
        uv.x + uTime * uSpeed * 0.2 * uColorSpeed,
        vec3(0.5),
        vec3(0.5),
        vec3(1.0),
        vec3(0.3, 0.20, 0.20)
      ) * uColor1;
      color += 0.99 * auroraGlow(time + uLayerOffset) * cosineGradient(
        uv.x + uTime * uSpeed * 0.1 * uColorSpeed,
        vec3(0.5),
        vec3(0.5),
        vec3(2.0, 1.0, 0.0),
        vec3(0.5, 0.20, 0.25)
      ) * uColor2;
      color *= uBrightness;
      float alpha = clamp(length(color), 0.0, 1.0);
      gl_FragColor = vec4(color, alpha);
    }
  `;

  const hexToVec3 = (hex: string) => {
    const value = hex.replace('#', '');
    return [
      Number.parseInt(value.slice(0, 2), 16) / 255,
      Number.parseInt(value.slice(2, 4), 16) / 255,
      Number.parseInt(value.slice(4, 6), 16) / 255,
    ];
  };

  const root = document.querySelector<HTMLElement>('[data-profile-aurora]');

  if (root && root.dataset.initialized !== 'true') {
    root.dataset.initialized = 'true';
    const container = root.querySelector<HTMLElement>('[data-soft-aurora]');

    if (container) {
      try {
        const renderer = new Renderer({
          alpha: true,
          dpr: Math.min(window.devicePixelRatio || 1, window.innerWidth < 700 ? 1 : 1.35),
          premultipliedAlpha: false,
          powerPreference: 'low-power',
        });
        const gl = renderer.gl;
        gl.clearColor(0, 0, 0, 0);
        gl.canvas.style.width = '100%';
        gl.canvas.style.height = '100%';
        container.appendChild(gl.canvas);

        const program = new Program(gl, {
          vertex: vertexShader,
          fragment: fragmentShader,
          transparent: true,
          uniforms: {
            uTime: { value: 0 },
            uResolution: { value: [1, 1, 1] },
            uSpeed: { value: 0.6 },
            uScale: { value: 1.5 },
            uBrightness: { value: 1 },
            uColor1: { value: hexToVec3('#ff9d45') },
            uColor2: { value: hexToVec3('#96c8ff') },
            uNoiseFrequency: { value: 2.5 },
            uNoiseAmplitude: { value: 1 },
            uBandHeight: { value: 0.5 },
            uBandSpread: { value: 1 },
            uOctaveDecay: { value: 0.1 },
            uLayerOffset: { value: 0 },
            uColorSpeed: { value: 1 },
          },
        });
        const mesh = new Mesh(gl, { geometry: new Triangle(gl), program });

        const resize = () => {
          renderer.setSize(Math.max(container.clientWidth, 1), Math.max(container.clientHeight, 1));
          program.uniforms.uResolution.value = [
            gl.canvas.width,
            gl.canvas.height,
            gl.canvas.width / Math.max(gl.canvas.height, 1),
          ];
        };

        const render = (time: number) => {
          program.uniforms.uTime.value = time * 0.001;
          renderer.render({ scene: mesh });
        };

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let frameId = 0;
        let isVisible = true;

        const stop = () => {
          if (frameId) window.cancelAnimationFrame(frameId);
          frameId = 0;
        };

        const loop = (time: number) => {
          render(time);
          frameId = window.requestAnimationFrame(loop);
        };

        const start = () => {
          if (!frameId && isVisible && !document.hidden && !reducedMotion.matches) {
            frameId = window.requestAnimationFrame(loop);
          }
        };

        const handleMotionPreference = () => {
          stop();
          render(0);
          start();
        };

        const handleVisibility = () => {
          if (document.hidden) stop();
          else start();
        };

        const visibilityObserver = new IntersectionObserver(
          ([entry]) => {
            isVisible = entry?.isIntersecting ?? false;
            if (isVisible) start();
            else stop();
          },
          { threshold: 0.01 },
        );
        const resizeObserver = new ResizeObserver(() => {
          resize();
          render(0);
        });

        resize();
        render(0);
        visibilityObserver.observe(root);
        resizeObserver.observe(root);
        document.addEventListener('visibilitychange', handleVisibility);
        reducedMotion.addEventListener('change', handleMotionPreference);
        start();

        window.addEventListener(
          'pagehide',
          () => {
            stop();
            visibilityObserver.disconnect();
            resizeObserver.disconnect();
            document.removeEventListener('visibilitychange', handleVisibility);
            reducedMotion.removeEventListener('change', handleMotionPreference);
            gl.getExtension('WEBGL_lose_context')?.loseContext();
          },
          { once: true },
        );
      } catch {
        root.dataset.webglUnavailable = 'true';
      }
    }
  }
</script>

<style>
  .profile-aurora {
    position: absolute;
    z-index: 0;
    width: 100vw;
    height: clamp(18rem, 30vw, 26rem);
    overflow: hidden;
    pointer-events: none;
    inset-block-start: clamp(-8rem, -9vw, -5rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
  }

  .profile-aurora__canvas {
    position: absolute;
    mix-blend-mode: screen;
    inset: 0;
  }

  :global(:root[data-theme='light']) .profile-aurora__canvas {
    mix-blend-mode: multiply;
  }

  @media (max-width: 640px) {
    .profile-aurora {
      height: 18rem;
      inset-block-start: -4.5rem;
    }
  }
</style>
