---
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return ['en', 'tr'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as 'en' | 'tr';
const entry = await getEntry('profile', locale);
if (!entry) throw new Error(`Missing CV content for locale: ${locale}`);
const content = entry.data;
const labels = {
  en: {
    profile: 'Profile',
    experience: 'Research Experience',
    education: 'Education',
    skills: 'Skills',
    recognition: 'Selected Recognition',
    projects: 'Selected Projects',
    learning: 'Independent Learning',
    languages: 'Languages',
  },
  tr: {
    profile: 'Profil',
    experience: 'Araştırma Deneyimi',
    education: 'Eğitim',
    skills: 'Beceriler',
    recognition: 'Seçilmiş Başarılar',
    projects: 'Seçilmiş Projeler',
    learning: 'Bağımsız Öğrenme',
    languages: 'Diller',
  },
}[locale];
---

<!doctype html>
<html lang={locale} dir={content.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{content.name} · CV</title>
  </head>
  <body>
    <main>
      <header>
        <div>
          <p class="eyebrow">Curriculum Vitae</p>
          <h1>{content.name}</h1>
          <p class="headline">{content.headline}</p>
        </div>
        <address>
          <span>{content.contact.location}</span>
          <a href={`mailto:${content.contact.email}`}>{content.contact.email}</a>
          <a href={content.contact.github}>github.com/MoeHussein</a>
          <a href={content.contact.orcid}>ORCID 0009-0009-7211-0974</a>
        </address>
      </header>

      <section class="profile">
        <h2>{labels.profile}</h2>
        <p>{content.about.paragraphs.join(' ')}</p>
      </section>

      <div class="columns">
        <div class="primary">
          <section>
            <h2>{labels.experience}</h2>
            {
              content.timeline.map((item) => (
                <article>
                  <p class="date">{item.period}</p>
                  <h3>{item.title}</h3>
                  <p class="organization">{item.organization}</p>
                  <p>{item.description}</p>
                </article>
              ))
            }
          </section>

          <section>
            <h2>{labels.education}</h2>
            {
              content.education.map((item) => (
                <article>
                  <p class="date">{item.period}</p>
                  <h3>{item.degree}</h3>
                  <p class="organization">{item.institution}</p>
                  <ul>
                    {item.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </section>

          <section>
            <h2>{labels.projects}</h2>
            {
              content.projects.slice(0, 5).map((project) => (
                <article class="compact">
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                  <p class="tech">{project.technologies.join(' · ')}</p>
                </article>
              ))
            }
          </section>
        </div>

        <aside>
          <section>
            <h2>{labels.skills}</h2>
            {
              content.skillGroups.map((group) => (
                <div class="skill-group">
                  <h3>{group.title}</h3>
                  <p>{group.items.join(' · ')}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>{labels.recognition}</h2>
            {
              content.achievements.map((item) => (
                <article class="compact">
                  <p class="date">{item.date}</p>
                  <h3>{item.title}</h3>
                  <p>{item.detail}</p>
                </article>
              ))
            }
          </section>

          <section>
            <h2>{labels.learning}</h2>
            <ul>{content.learning.map((item) => <li>{item.label}</li>)}</ul>
          </section>

          <section>
            <h2>{labels.languages}</h2>
            <ul class="language-list">
              {
                content.languages.map((item) => (
                  <li>
                    <strong>{item.language}</strong> - {item.level}
                  </li>
                ))
              }
            </ul>
          </section>
        </aside>
      </div>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 12mm;
  }
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    color: #17202a;
    background: #fff;
    font-family: Arial, 'Noto Sans Arabic', sans-serif;
    font-size: 9.2pt;
    line-height: 1.46;
  }
  main {
    max-width: 186mm;
    margin: 0 auto;
  }
  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8mm;
    align-items: end;
    padding-block-end: 6mm;
    border-block-end: 2px solid #158e8a;
  }
  .eyebrow,
  h2,
  .date {
    color: #158e8a;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }
  .eyebrow {
    margin: 0 0 1.5mm;
    font-size: 7.5pt;
  }
  h1 {
    margin: 0;
    font-size: 27pt;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .headline {
    max-width: 125mm;
    margin: 2mm 0 0;
    color: #3f5965;
    font-weight: 700;
  }
  address {
    display: grid;
    gap: 0.6mm;
    font-style: normal;
    font-size: 8pt;
    text-align: end;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  section {
    break-inside: avoid;
  }
  .profile {
    display: grid;
    grid-template-columns: 35mm 1fr;
    gap: 6mm;
    margin: 6mm 0;
  }
  .profile p {
    margin: 0;
    color: #33434b;
  }
  .columns {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: 9mm;
  }
  .primary {
    padding-inline-end: 8mm;
    border-inline-end: 1px solid #d8e2e4;
  }
  h2 {
    margin: 0 0 3mm;
    padding-block-end: 1.4mm;
    border-block-end: 1px solid #b9d8d7;
    font-size: 8.3pt;
  }
  h3 {
    margin: 0;
    font-size: 10pt;
    line-height: 1.25;
  }
  article {
    margin-block-end: 4mm;
    break-inside: avoid;
  }
  article p {
    margin: 1mm 0 0;
  }
  .date {
    margin: 0 0 0.6mm;
    font-size: 7pt;
  }
  .organization {
    color: #51636b;
    font-weight: 700;
  }
  ul {
    margin: 1mm 0 0;
    padding-inline-start: 4mm;
  }
  li {
    margin-block-end: 0.7mm;
  }
  .compact {
    margin-block-end: 3mm;
  }
  .tech {
    color: #526d74;
    font-size: 7.7pt;
  }
  .skill-group {
    margin-block-end: 3.5mm;
    break-inside: avoid;
  }
  .skill-group h3 {
    margin-block-end: 1mm;
  }
  .skill-group p {
    margin: 0;
    color: #40545c;
  }
  .language-list strong {
    font-weight: 700;
  }
  aside section {
    margin-block-end: 6mm;
  }
  html[dir='rtl'] .primary {
    padding-inline: 0 8mm;
  }
  html[dir='rtl'] address {
    text-align: start;
  }
</style>
